# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Cache
.cache/
.parcel-cache/
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lockfiles (keep one, ignore others)
# If using npm:
# yarn.lock
# pnpm-lock.yaml
# If using yarn:
# package-lock.json
# pnpm-lock.yaml
# If using pnpm:
# package-lock.json
# yarn.lock

# Testing
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# Storybook
storybook-static/

# Sentry
.sentryclirc


# ============================================================
# DATABASE
# ============================================================
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
pg_dump/
db_backups/


# ============================================================
# DOCKER
# ============================================================
# Keep Dockerfile and docker-compose.yml in source control
# Ignore override files with local secrets
docker-compose.override.yml
docker-compose.local.yml
.docker/


# ============================================================
# UPLOADED FILES & MEDIA
# ============================================================
# Never commit user-uploaded documents, NDAs, profile pics, etc.
backend/media/
uploads/
documents/
temp_files/
tmp/
*.pdf
*.docx
*.xlsx
*.pptx
*.zip
*.tar.gz
# Exception: keep sample/test fixtures if needed
!backend/fixtures/


