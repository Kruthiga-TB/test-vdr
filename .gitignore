# ============================================================
#   VDR PLATFORM — .gitignore
#   Django REST Framework + Next.js + PostgreSQL
# ============================================================


# ============================================================
# ENVIRONMENT & SECRETS — NEVER commit these
# ============================================================
.env
.env.*
!.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/


# ============================================================
# PYTHON / DJANGO (backend/)
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# Django
*.log
*.pot
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# Django migrations (keep these — they are part of source)
# Do NOT ignore migrations/

# Celery
celerybeat-schedule
celerybeat.pid
*.celerybeat

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
nosetests.xml
pytest.xml

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pyright
pyrightconfig.json

# Pylint
.pylint.d/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/
parts/
sdist/
var/
*.manifest
*.spec

# Unit test / coverage reports
.tox/
.nox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Pipenv / Poetry
Pipfile.lock
poetry.lock

# Rope project settings
.ropeproject

# mkdocs documentation
/site


# ============================================================
